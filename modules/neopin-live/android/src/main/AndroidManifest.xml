<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 16 keeps the search in the status bar as a live update, once the person allows
       live updates for NeoPin. Older versions show the plain ongoing notification. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <application>
    <receiver android:name="de.vensin.neopin.live.LiveActionReceiver" android:exported="false" />
  </application>
</manifest>
