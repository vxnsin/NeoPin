PORT=3012
# The admin account is created on the first start with a generated password, printed once in the log.
# Push notifications (Firebase Cloud Messaging), see "Push notifications" in the README. Unset or "off" turns them off.
# FCM_SERVICE_ACCOUNT_FILE=/app/data/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_JSON=
# How long asking an offline phone for its location waits, in ms.
# PUSH_WAIT_MS=20000
# Invite codes: any account can invite people to sign up. "off" disables them.
# INVITE_CODES=on
# INVITE_TTL_DAYS=7
# INVITE_MAX_OPEN=5
# Trips snapped to the roads by the server's own matcher ("own"), an OSRM server ("osrm") or not at all ("off").
# ROAD_MATCH=own
# While a trip's road tiles load, OSRM at ROAD_MATCH_URL stands in; "off" keeps those trips on their fixes.
# ROAD_MATCH_FALLBACK=on
# The roads come from OpenStreetMap, a map tile at a time: the OpenFreeMap vector tiles ("openfreemap",
# ROADS_URL is their TileJSON) or an Overpass API ("overpass", ROADS_URL is the API). "off" asks nothing.
# ROADS_SOURCE=openfreemap
# ROADS_URL=https://tiles.openfreemap.org/planet
# ROADS=on
# The height of the ground under every fix, from free elevation tiles (AWS Open Data). "off" turns it off.
# ELEVATION=on
# ELEVATION_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
